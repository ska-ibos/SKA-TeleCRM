# ---- Supabase (leave blank to run in local DEMO mode with in-memory data) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only - never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# SKA OS workspace TeleCRM runs in (public.tenants). Slug defaults to "ska".
TELECRM_TENANT_SLUG=ska
# TELECRM_TENANT_ID=

# ---- Telephony ----
# simulation | exotel   (exotel = real calls; the simulator keeps working, flagged SIMULATED)
TELEPHONY_PROVIDER=simulation
# Exotel - Dashboard > Settings > API Settings. Server-only: never commit real values.
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
# API host for your account's region: api.exotel.com (Singapore) or api.in.exotel.com (Mumbai)
EXOTEL_SUBDOMAIN=api.exotel.com
# Your ExoPhone (office number) in E.164, e.g. +919513886363 - caller ID for click-to-call
EXOTEL_OPERATIONS_NUMBER=
# Public https address of this app (Exotel calls back here), e.g. https://telecrm.example.com
APP_BASE_URL=
# Long random string. Exotel cannot sign requests, so it is put in every Exotel URL as ?token=...
TELEPHONY_WEBHOOK_SECRET=
# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" to /api/cron/maintenance
# (closes calls abandoned in the menu, archives recordings to Supabase Storage). Long random string.
CRON_SECRET=

# Session signing secret for DEMO mode cookies (any long random string)
DEMO_SESSION_SECRET=

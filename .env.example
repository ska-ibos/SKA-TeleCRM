# ---- Supabase (leave blank to run in local DEMO mode with in-memory data) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only - never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# SKA OS workspace TeleCRM runs in (public.tenants). Slug defaults to "ska".
TELECRM_TENANT_SLUG=ska
# TELECRM_TENANT_ID=

# ---- Telephony ----
# simulation | exotel
TELEPHONY_PROVIDER=simulation
# Exotel - fill only when official credentials are issued
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=
EXOTEL_OPERATIONS_NUMBER=
# Shared secret that inbound webhooks must send in the x-webhook-secret header
TELEPHONY_WEBHOOK_SECRET=

# Session signing secret for DEMO mode cookies (any long random string)
DEMO_SESSION_SECRET=
